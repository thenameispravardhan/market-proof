*.txt

# Local data
data/
*.db
*.sqlite
*.sqlite3

# Local env (ignore every .env variant except the committed template)
.env
.env.*


# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
# Word owner/lock files (~$Foo.docx) — orphaned when a .docx is moved
~$*

# Runtime / mavis / opencode state (NOT part of the project)
.mavis/
.opencode/

node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Frontend build artifacts
frontend/dist/

# Local log files (uvicorn output, monitor errors, etc.)
logs/*.log
logs/*.err

# Fyers SDK WebSocket logs (written to cwd by fyers-apiv3; we redirect
# them into logs/ but ignore the root-level fallback too).
fyersDataSocket.log
fyersOrderSocket.log
fyersRequests.log

# Live-trading safety sentinel (operator-created, not committed)
.i_accept_live_risk

# Concrete deploy target (server IP / domain / SSH key path) — private to
# each operator's machine; the committed template is target.local.env.example.
deploy/target.local.env

*.docx

# The research corpus (12 GB of parquet, raw dumps, trained boosters) never
# goes in git. The ONE exception is the exported model: a ~300 KB JSON that
# the RUNNING BOT reads (app/services/mover_model.py), so it has to travel
# with the deploy like any other build artifact. Git cannot re-include a file
# under an excluded DIRECTORY, so each level is excluded by content (`/*`)
# and then re-included. Regenerate with AIdataset/model/export_live.py.
AIdataset/*
!AIdataset/model/
AIdataset/model/*
!AIdataset/model/live_model.json
# The scripts that BUILD it, too. train.py has always lived outside git, but
# an artifact the bot depends on must not become unreproducible if this
# machine dies — these two are the only way to regenerate it.
!AIdataset/model/export_live.py
!AIdataset/model/train.py

c++.text