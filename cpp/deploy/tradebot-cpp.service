# c++.text §9 PHASE 1 -- runs ALONGSIDE the Python unit, owns nothing.
#
# Deliberately NOT wired into Caddy: until a phase moves a responsibility over,
# nothing should be able to reach this process from outside the box (it listens
# on 127.0.0.1 only).
[Unit]
Description=TRADEBOT C++ backend (migration, phase 1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tradebot
# One build dir. A second (build-http) existed only to keep Drogon out of
# the test build; cpp-httplib is cheap enough that the split bought nothing
# and cost a 203/EXEC when the two drifted apart.
ExecStart=/home/ubuntu/tradebot/cpp/build/tradebot
Restart=on-failure
RestartSec=5

# §1.4: the box has 127 MB free and the Python already holds 1.36 GB. A cap
# here means a leak in the new stack kills the new stack, not the trading one.
# Measured RSS is ~8.5 MB; 200M is a leak backstop, not a target.
MemoryMax=200M

# §12 invariant I12: no unbounded allocation during market hours. This is the
# blunt backstop; the aborting allocator in the test build is the real one.
OOMPolicy=stop

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/tradebot/logs

[Install]
WantedBy=multi-user.target
