# Caddy reverse proxy for the AI News Trading Bot.
# Template — deploy/setup.sh fills in __DOMAIN__ / __BASIC_USER__ /
# __BASIC_HASH__ and installs it to /etc/caddy/Caddyfile.
#
# Everything is protected by basic auth EXCEPT the Fyers order postback,
# which Fyers' servers call without credentials. That endpoint checks its
# own ?token=<FYERS_POSTBACK_SECRET> and is closed when no secret is set.
# The matcher is the exact path, so /api/fyers/postback/url stays behind auth.
#
# TLS certificates are provisioned automatically via Let's Encrypt as
# soon as the domain's A record points at this server.

__DOMAIN__ {
	encode gzip

	@postback path /api/fyers/postback
	handle @postback {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		basic_auth {
			__BASIC_USER__ __BASIC_HASH__
		}
		# Same-origin SPA + API + /ws WebSocket upgrade all pass through.
		reverse_proxy 127.0.0.1:8000
	}
}
