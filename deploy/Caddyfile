# Caddy reverse proxy for the AI News Trading Bot.
# Template — deploy/setup.sh fills in __DOMAIN__ / __BASIC_USER__ /
# __BASIC_HASH__ and installs it to /etc/caddy/Caddyfile.
#
# Everything is protected by basic auth. (There used to be an exemption
# for the Fyers order postback; that endpoint was removed — the new Fyers
# API dashboard has no webhook field, so it could never fire.)
#
# TLS certificates are provisioned automatically via Let's Encrypt as
# soon as the domain's A record points at this server.

__DOMAIN__ {
	encode gzip

	handle {
		basic_auth {
			__BASIC_USER__ __BASIC_HASH__
		}
		# Same-origin SPA + API + /ws WebSocket upgrade all pass through.
		reverse_proxy 127.0.0.1:8000
	}
}
