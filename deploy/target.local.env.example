# -----------------------------------------------------------------------------
# Deploy target — WHERE the live server is + HOW to reach it.
#
# Copy this file to  deploy/target.local.env  and fill in your values.
# deploy/target.local.env is GITIGNORED (it names your production server), so
# it stays on your machine and is never pushed to the public repo.
#
# deploy/push.sh and deploy/push.ps1 read this file to run a one-command
# redeploy over SSH. Without it, a fresh session has no way to know the server
# address — which is exactly the "I don't have the server address" dead-end
# this file exists to prevent.
# -----------------------------------------------------------------------------

# The Lightsail static IP (preferred — never changes while attached).
TRADEBOT_SERVER_IP=13.200.57.14

# The public dashboard hostname (DuckDNS). Either this or the IP works for SSH.
TRADEBOT_DOMAIN=your-subdomain.duckdns.org

# SSH login user on the Ubuntu instance.
TRADEBOT_SSH_USER=ubuntu

# Path to the Lightsail private key (.pem) ON THIS MACHINE.
#   Git Bash / WSL:  ~/.ssh/lightsail-tradebot.pem
#   Windows native:  C:/Users/<you>/.ssh/lightsail-tradebot.pem
TRADEBOT_SSH_KEY=~/.ssh/lightsail-tradebot.pem

# Project directory on the server (where update.sh lives).
TRADEBOT_REMOTE_DIR=~/tradebot
