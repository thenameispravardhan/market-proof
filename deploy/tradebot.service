# systemd unit for the AI News Trading Bot.
# Template — deploy/setup.sh fills in __PROJECT_ROOT__ / __RUN_USER__ and
# installs it to /etc/systemd/system/tradebot.service.
#
# Deliberate choices:
#   - Binds to 127.0.0.1 only; Caddy terminates TLS + basic auth in front.
#   - --no-proxy-headers is REQUIRED: uvicorn processes X-Forwarded-For
#     by default and trusts 127.0.0.1, so Caddy's forwarded headers would
#     rewrite each request's client IP to the browser's public IP and trip
#     the loopback-only guard on /ws (app/api/ws.py) — every dashboard
#     WebSocket would be rejected with 403.
#   - Single worker, always: the app is one stateful process (in-memory
#     event bus, schedulers, Fyers sockets). Multiple workers would each
#     start their own monitors and place duplicate trades.
#   - WorkingDirectory matters: DATABASE_URL is ./data/trading.db and the
#     Fyers SDK writes its socket logs relative to cwd.

[Unit]
Description=AI News Trading Bot (FastAPI + uvicorn)
After=network-online.target
Wants=network-online.target

# Give up after 5 failed starts in 5 minutes instead of retrying forever.
# A PERMANENT failure — a corrupt data/trading.db, a broken .env, a bad
# import — cannot be fixed by trying again, and `Restart=always` with no
# limit hides it: the unit sits in `activating (auto-restart)`, which reads
# like a slow boot, not like an outage. On 2026-08-07 that cost a full
# trading day, 9,000+ restarts deep, because nothing ever said "failed".
# With a limit the unit lands in `failed`, `systemctl is-active` reports it,
# and the health report / monitoring has something to see.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=__RUN_USER__
WorkingDirectory=__PROJECT_ROOT__
ExecStart=__PROJECT_ROOT__/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-proxy-headers
Restart=always
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65535

# Memory ceiling. The box is 1.9 GB and the process drifts upward over a
# multi-day run (707 MB RSS + 1 GB swap after two days, 2026-08-25). On
# 2026-08-15 the GLOBAL oom-killer fired — an unrelated `appstreamcli`
# starved the box and the kernel picked uvicorn, taking the whole server
# with it. A cgroup ceiling turns that into a 3-second restart of one
# unit: MemoryHigh throttles and reclaims first, MemoryMax kills only if
# reclaim fails. Sized above the ~1.0 GB peak of a full gap re-ingest.
MemoryHigh=1G
MemoryMax=1400M

[Install]
WantedBy=multi-user.target
