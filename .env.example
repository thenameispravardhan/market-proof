# ---------- Trading core ----------
# paper | live
TRADING_MODE=paper

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=

# ---------- FYERS (broker) ----------
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
FYERS_REDIRECT_URI=http://localhost:8000/api/fyers/callback
# HMAC-SHA256 secret for the Fyers postback (inbound) webhook.
# Used by scripts/register_fyers_webhook.py to populate the
# webhooks.secret column. Must match whatever you put in the
# Fyers API dashboard's Postback URL config.
FYERS_POSTBACK_SECRET=

# ---------- Storage ----------
# Ignored if TESTING=1
DATABASE_URL=sqlite:///./data/trading.db

# ---------- Server ----------
BIND_HOST=127.0.0.1
BIND_PORT=8000
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=5

# ---------- Risk defaults (overridable per-strategy in the DB) ----------
MAX_CAPITAL_RISK_PCT=1.0
DAILY_MAX_LOSS_PCT=2.0
MAX_CONCURRENT_POSITIONS=5
MAX_SINGLE_POSITION_PCT=20.0
MIN_LIQUIDITY_CRORE=5.0
MAX_SIGNALS_PER_DAY=20

# ---------- Speed-trading rules ----------
# Maximum age of an announcement (vs. filed_at) before the analyzer
# refuses to call the LLM and writes a placeholder analyses row.
# Implements "no trades on old queued news". The startup sweep also
# pre-marks every announcement older than this so a queue replay
# (manual tool, future redelivery) never re-fires the LLM on backlog.
MAX_NEWS_AGE_SECONDS=90
# Maximum time (seconds) the trade manager holds an open position
# before force-closing at the last quote (reason=TIME_EXIT).
# Captures the "20-30 min spike" rule. Per-trade overrides can be
# supplied by the execution manager.
MAX_HOLD_SECONDS=1800

# ---------- Internal ----------
# Set to 1 by pytest; swaps DATABASE_URL to sqlite:///:memory:
TESTING=0
