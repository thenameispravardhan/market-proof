# ---------- Trading core ----------
# paper | live
TRADING_MODE=paper

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=

# ---------- FYERS (broker) ----------
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
FYERS_REDIRECT_URI=http://localhost:8000/api/fyers/callback
# HMAC-SHA256 secret for the Fyers postback (inbound) webhook.
# Used by scripts/register_fyers_webhook.py to populate the
# webhooks.secret column. Must match whatever you put in the
# Fyers API dashboard's Postback URL config.
FYERS_POSTBACK_SECRET=

# ---------- Storage ----------
# Ignored if TESTING=1
DATABASE_URL=sqlite:///./data/trading.db

# ---------- Server ----------
BIND_HOST=127.0.0.1
BIND_PORT=8000
LOG_LEVEL=INFO
# Lower = faster filing detection; too low risks NSE/BSE 403/rate-limit.
POLL_INTERVAL_SECONDS=2

# ---------- Speed / LLM latency ----------
# Hard cap on LLM completion tokens (clamped against each prompt
# template's own max_tokens). A signal JSON needs only a few hundred
# tokens; capping here cuts seconds off every analysis. 1024 keeps that
# win while leaving headroom so a verbose response can't truncate its
# JSON (a truncated response fails to parse and the signal is lost) —
# don't set it below what a full signal JSON needs.
LLM_MAX_TOKENS=1024
# Skip the slow, paid LLM call for clearly-administrative filings
# (trading-window notices, compliance certs, newspaper publications, …).
PRE_LLM_FILTER_ENABLED=true

# ---------- Risk defaults (overridable per-strategy in the DB) ----------
MAX_CAPITAL_RISK_PCT=1.0
DAILY_MAX_LOSS_PCT=2.0
MAX_CONCURRENT_POSITIONS=5
MAX_SINGLE_POSITION_PCT=20.0
MIN_LIQUIDITY_CRORE=5.0
MAX_SIGNALS_PER_DAY=20

# ---------- Speed-trading rules ----------
# Maximum age of an announcement (vs. filed_at) before the analyzer
# refuses to call the LLM and writes a placeholder analyses row.
# Implements "no trades on old queued news". The startup sweep also
# pre-marks every announcement older than this so a queue replay
# (manual tool, future redelivery) never re-fires the LLM on backlog.
MAX_NEWS_AGE_SECONDS=90
# Maximum time (seconds) the trade manager holds an open position
# before force-closing at the last quote (reason=TIME_EXIT).
# Captures the "20-30 min spike" rule. Per-trade overrides can be
# supplied by the execution manager.
MAX_HOLD_SECONDS=1800

# ---------- Volatility-aware stops (ATR) ----------
# When ATR is available the initial stop is ATR_STOP_MULT×ATR, clamped to
# [DEFAULT_SL_MIN_PCT, ATR_MAX_STOP_PCT] of entry; otherwise the % stop
# applies. Wider stops on volatile names cut whipsaw. Live ATR comes from
# Fyers history candles; fail-safe — with no connected Fyers account the
# feed returns nothing and the % stop applies.
ATR_ENABLED=true
ATR_PERIOD=14
ATR_STOP_MULT=2.0
ATR_MAX_STOP_PCT=8.0

# ---------- Entry-quality guards ----------
# Anti-chase: skip (block ENTRY_DRIFT) when the order-time price already ran
# more than this % in the trade's favour vs the signal's intended entry.
ENTRY_MAX_DRIFT_PCT=1.5
# Bid/ask spread + India VIX gates read MAX_SPREAD_PCT / INDIA_VIX_MAX; both
# are fail-safe (skip) until their L1 / VIX feeds are wired.

# ---------- Clustering control ----------
# Whole-portfolio sector value cap, max distinct names per sector, and the
# one-name-per-event window (block a 2nd same-sector entry inside it).
SECTOR_CONCENTRATION_PCT=25.0
MAX_POSITIONS_PER_SECTOR=2
SECTOR_CLUSTER_WINDOW_SECONDS=120

# ---------- Internal ----------
# Set to 1 by pytest; swaps DATABASE_URL to sqlite:///:memory:
TESTING=0
